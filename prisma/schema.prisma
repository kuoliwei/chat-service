generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  title       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 🆕 角色快照（建立對話時保存，防止後續編輯影響已有對話）
  characterName         String?
  characterGender       String?
  characterTags         String?   // JSON 字符串
  characterIntroduction String?
  characterBackground   String?
  characterOpening      String?
  characterFewShots     String?   // JSON 字符串

  // 🆕 主角人設（使用者扮演的主人公，針對個別聊天室設定，預設空白不強制）
  protagonistName       String?
  protagonistBackground String?

  // AI 生成狀態追蹤（原本存在進程內記憶體 Map，改為持久化欄位）：
  // generationStatus 為 null 表示目前沒有生成任務在進行（初始狀態，或狀態已被清除）。
  // 'generating' 同時扮演並行鎖角色——sendMessageToConversation 寫入前用
  // updateMany({ where: { id, generationStatus: { not: 'generating' } } }) 做原子性的
  // 「檢查後更新」，取代原本 in-memory Map 天然單執行緒同步區塊提供的原子性。
  generationStatus            String?   // 'generating' | 'completed' | 'failed'
  generationError             String?
  generationTempUserId        String?
  generationUserMessageId     String?
  generationAssistantMessageId String?
  generationUpdatedAt         DateTime?

  // 一對多關聯：一個對話有多條訊息
  messages    Message[]

  @@index([userId])
  @@index([characterId])
}

// 聊天室建立流程的狀態追蹤（原本存在進程內記憶體 Map，改為持久化）。
// 對話建立完成前 Conversation 記錄還不存在，所以需要獨立的表，
// key 是 userId + characterId（同一使用者對同一角色同時只會有一個建立中的 job）。
model ConversationCreationJob {
  userId         String
  characterId    String
  status         String    // 'preparing' | 'failed'
  conversationId String?   // 已產生、準備寫入的對話 ID（preparing 階段就先決定，失敗時保留供除錯）
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@id([userId, characterId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user" or "assistant"
  text           String
  status         String       @default("completed")  // "pending" or "completed"
  summarized     Boolean      @default(false)        // 是否已被製作成歷史摘要
  summaryId      String?                             // 🆕 涵蓋此訊息的摘要 ID（= Qdrant point id，未摘要為 null）
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // 多對一關聯：多條訊息屬於一個對話
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}
